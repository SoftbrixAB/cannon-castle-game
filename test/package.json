{
  "name": "cannon-castle-game-tests",
  "version": "1.0.0",
  "description": "Node.js tests for Cannon Castle Game",
  "main": "game.test.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:all": "jest && jest page-load.test.js",
    "test:playwright": "cd playwright && playwright test",
    "test:play": "cd playwright && playwright test",
    "test:full": "jest && cd playwright && playwright test"
  },
  "keywords": [
    "game",
    "test",
    "phaser"
  ],
  "author": "",
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": ["/playwright/"]
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "dependencies": {
    "@playwright/test": "^1.40.0",
    "playwright": "^1.40.0"
  }
}
